{{#*inline "page"}}
    <h1>Lecture {{ lec_id }} admin</h1>

    <form action="/admin/lec/edit/{{ lec_id }}" method="post" accept-charset="utf-8">
      <p>
        <label>Title: <input name="lec_name" value="{{ title }}" required />
        </label>
      </p>
      <p>
        <label>Presenters (CSV list of emails): <input name="lec_presenters" value="{{ presenters }}" />
        </label>
      </p>

      <input type="submit" class="btn btn-primary" value="Update">
    </form>

    <hr/>

    <h2>Current questions</h2>
    <ul>
      {{#each questions}}
      <li>{{ this.question_number }}: {{{ this.question }}} &ndash; <a href="/admin/lec/{{ ../lec_id }}/{{ this.id }}">edit</a> &ndash; <a href="/admin/analysis/{{ ../lec_id }}/{{ this.id }}">analyze</a></li>
      {{/each}}
    </ul>

    <h2>Add question</h2>
    <form action="/admin/lec/{{ lec_id }}" method="post" accept-charset="utf-8">
      <p>
        <label>Question prompt:<br />
        <textarea name="q_prompt" rows="10" cols="80" placeholder="Ask something here." required></textarea>
        </label>
      </p>

      <input type="submit" class="btn btn-primary" value="Add question">
    </form>
{{/inline}}
{{~> layout~}}
