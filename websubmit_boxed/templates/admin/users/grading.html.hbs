{{#*inline "page"}}
    <h1>Grading report</h1>

    <table>
      <thead>
        <tr>
          <th scope="col">Email</th>
          <th scope="col">Total (/{{ lectures_count }})</th>
          {{#each lectures}}
          <th scope="col">{{ this.label }} (/{{ this.num_qs }})</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each users}}
        <tr>
          <td>{{ this.email }}</td>
          <td>{{ this.total }}</td>
          {{#each this.lectures}}
          <td>{{ this }}</td>
          {{/each}}
        </tr>
        {{/each}}
      </tbody>
    </table>

    <hr>
    <br><br><br>
    <h3>CSV</h3>
    <pre>
Email,"Total (/{{ lectures_count }})"{{#each lectures}},{{csv this.label " (/" this.num_qs ")"}}{{/each}}
{{#each users}}{{csv this.email}},{{ this.total }}{{#each this.lectures}},{{ this }}{{/each}}
{{/each}}
    </pre>
{{/inline}}
{{~> layout~}}
