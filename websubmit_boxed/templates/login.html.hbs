{{#*inline "page"}}
    <h1>Welcome to the {{ CLASS_ID }} submission system!</h1>

    <h5>Generate API key:</h5>
    <form action="/apikey/generate" method="post" accept-charset="utf-8">
        <p>
            <label>Your email address:
                <input name="email" type="email" autocomplete="email" required />
            </label>
        </p>
        <p>
            <label>Do you consent to automated analysis of your answers to improve the course?
                No automated analysis will ever factor into grading or course performance.
                <input name="consent" type="checkbox" checked />
            </label>
        </p>
        <input type="submit" value="Submit">
    </form>

    <h5>Log in with API key</h5>
    <form action="/apikey/check" method="post" accept-charset="utf-8">
        <label>Your API key:
            <p>
                <input name="key" autocomplete="off" required />
            </p>
        </label>
        <input type="submit" value="Submit">
    </form>
{{/inline}}
{{~> layout~}}
